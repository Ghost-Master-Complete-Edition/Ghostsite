{
  "kind": "collectionType",
  "collectionName": "downloads",
  "info": {
    "singularName": "download",
    "pluralName": "downloads",
    "displayName": "Download"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "File_Name": {
      "type": "string"
    },
    "Download_Type": {
      "type": "enumeration",
      "enum": [
        "Mod",
        "BSP",
        "Soundtrack"
      ]
    },
    "Download_Link": {
      "type": "string"
    },
    "Download_Link_Installer": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Download_Type"
            },
            "Mod"
          ]
        }
      }
    }
  }
}
